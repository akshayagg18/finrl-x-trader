[Unit]
Description=Back up FinRL-X forward-paper SQLite state
After=finrl-forward.service

[Service]
Type=oneshot
User=finrl
Group=finrl
WorkingDirectory=/opt/finrl-x-trader
ExecStart=/opt/finrl-x-trader/.venv/bin/python -m scripts.backup_forward --db /opt/finrl-x-trader/runtime/trader.db --directory /opt/finrl-x-trader/runtime/backups --keep 30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/finrl-x-trader/runtime
