# Optional. Application works without this file or any broker credentials.
TRADER_DB=runtime/trader.db
# Use separate paper and live credentials. Never send these to the browser.
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=
# IBKR requires an authenticated TWS/IB Gateway session, API socket access,
# account id, and market-data entitlements. No automated login.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=31
IBKR_ACCOUNT=
# Enable only after paper-session verification described in BROKER_SETUP.md.
IBKR_CONNECTED_VERIFIED=false
# Optional OKX transport; not routed by the intraday replay scheduler.
# Verify Singapore account eligibility and regional endpoint before enabling.
OKX_REGION_VERIFIED=false
OKX_DEMO_KEY=
OKX_DEMO_SECRET=
OKX_DEMO_PASSPHRASE=
OKX_LIVE_KEY=
OKX_LIVE_SECRET=
OKX_LIVE_PASSPHRASE=

# Optional LLM research only. Keys stay server-side and are never returned to the UI.
# LLM analysis defaults disabled and paid calls additionally require explicit budget
# authorization in the persisted LLM configuration. No LLM can route orders.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=
